{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mw-dashboard",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mw-dashboard-topology"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE"
    }
  ]
}
