{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mw-dashboard.local/contracts/findings/v1/finding.schema.json",
  "title": "OSI Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id", "rule_id", "entity_id", "semantic_type", "display_name",
    "severity", "status", "summary", "diagnosis", "confidence", "first_seen",
    "last_seen", "coverage_state", "evidence", "related_entities", "details"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^find_[0-9a-f]{24}$"},
    "rule_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "pattern": "^cent_[0-9a-f]{24}$"},
    "semantic_type": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "warning", "info"]},
    "status": {"enum": ["OPEN", "ACKNOWLEDGED", "RESOLVED"]},
    "summary": {"type": "string", "minLength": 1},
    "diagnosis": {"type": "string", "minLength": 1},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score"],
      "properties": {
        "level": {"enum": ["confirmed", "probable", "possible", "insufficient"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "first_seen": {"type": "string", "format": "date-time"},
    "last_seen": {"type": "string", "format": "date-time"},
    "coverage_state": {"$ref": "coverage-state.schema.json"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "finding-evidence-ref.schema.json"}
    },
    "related_entities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^cent_[0-9a-f]{24}$"},
      "uniqueItems": true
    },
    "details": {"type": "object"}
  }
}
