{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mw-dashboard.local/contracts/findings/v1/operational-observation.schema.json",
  "title": "OSI OperationalObservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "entity_id", "semantic_type", "display_name", "observation_type", "observed_at", "value", "unit", "source", "quality"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "pattern": "^cent_[0-9a-f]{24}$"},
    "semantic_type": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "observation_type": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "value": {"type": ["string", "number", "integer", "boolean"]},
    "unit": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_host", "queue_manager", "collection_method", "evidence_class", "evidence_ref", "sample_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_host": {"type": "string", "minLength": 1},
        "queue_manager": {"type": "string", "minLength": 1},
        "collection_method": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["observed", "configured", "declared", "inferred"]},
        "evidence_ref": {"type": "string", "minLength": 1},
        "sample_id": {"type": "string", "minLength": 1}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "freshness"],
      "properties": {
        "coverage": {"enum": ["complete", "point_in_time", "partial", "failed", "not_collected"]},
        "freshness": {"enum": ["sampled", "stale", "unknown"]}
      }
    }
  }
}
